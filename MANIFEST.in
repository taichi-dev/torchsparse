include README.md
include LICENSE
include pyproject.toml

# Include all C++/CUDA source files and headers
recursive-include torchsparse/backend *.cpp *.cu *.h *.cuh
recursive-include torchsparse/backend *.hpp *.c

# Include Python files
recursive-include torchsparse *.py

# Exclude certain files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *~
global-exclude .git*
global-exclude .DS_Store
global-exclude __pycache__ 
